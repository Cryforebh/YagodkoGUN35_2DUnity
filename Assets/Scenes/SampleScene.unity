    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _objectName
      value: "\u0410\u043D\u0434\u0440\u0435\u0439"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Short
      value: "\u0414\u0435\u043D\u0438\u0441 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0434\u0435\u043B\u043E\u0432\u044B\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u0445."
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Answer
      value: "\u0427\u0442\u043E \u0442\u044B \u0442\u0443\u0442 \u043C\u0435\u0448\u043A\u0430\u0435\u0448\u044C
        \u0438\u0437 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442?
        \u0413\u043E\u0432\u043E\u0440\u0438\u0448\u044C \u0410\u0434\u0440\u0435\u0439
        \u043F\u0440\u0438\u0441\u043B\u0430\u043B? \u0425\u043E\u0440\u043E\u0448\u043E,
        \u043F\u043E\u0434\u043E\u0439\u0442\u0443 \u0447\u0435\u0440\u0435\u0437
        \u043F\u0430\u0440\u0443 \u043C\u0438\u043D\u0443\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Target
      value: 
      objectReference: {fileID: 1847150573}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Question
      value: "\u0422\u0435\u0440\u0435\u043D\u044C\u0442\u044C\u0435\u0432, \u044F
        \u0443\u0432\u0435\u0440\u0435\u043D \u044D\u0442\u043E \u043D\u0435 \u0442\u0432\u043E\u044F
        \u0432\u0438\u043D\u0430... \u041E, \u043F\u0440\u0438\u0432\u0435\u0442!
        \u0421\u043B\u0443\u0448\u0430\u0439, \u0443 \u043D\u0430\u0441 \u0442\u0443\u0442
        \u043D\u0435\u0440\u0430\u0437\u0431\u0435\u0440\u0438\u0445\u0430 \u0432
        \u0434\u0435\u043B\u043E\u0432\u044B\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u0445.
        \u041C\u043E\u0436\u0435\u0448\u044C \u0441\u0433\u043E\u043D\u044F\u0442\u044C
        \u0434\u043E \u0414\u0435\u043D\u0438\u0441\u0430, \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
        \u0435\u0433\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438? \u0417\u0430\u0440\u0430\u043D\u0435\u0435
        \u0441\u043F\u0430\u0441\u0438\u0431\u043E! "
      objectReference: {fileID: 0}

    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Answer
      value: "\u0427\u0442\u043E? \u041E\u0442\u0447\u0435\u0442?! \u0421\u043E\u0432\u0441\u0435\u043C
        \u0437\u0430\u0431\u044B\u043B... \u041A\u043E\u043D\u0435\u0447\u043D\u043E,
        \u0441\u043A\u043E\u0440\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u0443.
        \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u043B! "

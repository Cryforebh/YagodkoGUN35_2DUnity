        \u0434\u0435\u043D\u044C \u0425, \u0430 \u041C\u0430\u0439\u043A\u043B \u0443\u0436\u0435
        20 \u043C\u0438\u043D\u0443\u0442 \u043A\u0430\u043A \u0434\u043E\u043B\u0436\u0435\u043D
        \u0431\u044B\u043B \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043C\u043D\u0435
        \u043E\u0442\u0447\u0435\u0442! \u0421\u0445\u043E\u0434\u0438 \u043A \u043D\u0435\u043C\u0443,

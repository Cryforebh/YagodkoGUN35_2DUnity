    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Short
      value: "\u041D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F
        \u0423\u0421\u041B\u041F"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Short
      value: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C
        \u0443 \u041C\u0438\u0445\u0430\u0438\u043B\u0430 \u041F\u0430\u0442\u0430\u043F\u044B\u0447\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Answer
      value: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B? \u041E\u0442\u043B\u0438\u0447\u043D\u043E!
        \u0423\u0432\u0435\u0440\u0435\u043D \u044D\u0442\u043E \u0431\u044B\u043B\u043E
        \u043F\u0440\u043E\u0441\u0442\u043E."
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Target
      value: 
      objectReference: {fileID: 7651430297088867010}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Answer
      value: "\u041A\u0430\u043A\u043E\u0439 \u0435\u0449\u0451 \u0430\u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u0446\u0438\u0435\u0439?
        \u041A\u0442\u043E \u0435\u043C\u0443 \u044D\u0442\u043E \u043F\u043E\u0440\u0443\u0447\u0438\u043B?!
        \u041E\u0445, \u043F\u043E\u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u043B\u0435
        \u043E\u0431\u0435\u0434\u0430..."
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Target
      value: 
      objectReference: {fileID: 1056483392}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[0].Question
      value: "\u0422\u0430\u043A... \u0412\u0430\u0436\u043D\u043E \u0434\u0435\u043B\u043E
        \u043A \u0442\u0435\u0431\u0435. \u0422\u044B \u0432\u0435\u0434\u044C \u0443\u0436\u0435
        \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0441 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u043E\u043C
        \"\u0423\u043C\u043D\u043E\u0439 \u0421\u0438\u0441\u0442\u0435\u043C\u044B
        \u041B\u0430\u0437\u0435\u0440\u043D\u043E\u0439 \u041F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u0438\"?
        \u041D\u0443\u0436\u043D\u043E \u0447\u0442\u043E\u0431\u044B \u0442\u044B
        \u0435\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B.
        \u0411\u0443\u0434\u0443 \u0442\u0435\u0431\u0435 \u043E\u0447\u0435\u043D\u044C
        \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u0435\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 7651430295682703586, guid: 0b6c3789cd31eaf43bed3e68c124f096, type: 3}
      propertyPath: _quests.Array.data[1].Question
      value: "\u041A\u0430\u043A \u0434\u0435\u043B\u0430?! \u0421\u043B\u0443\u0448\u0430\u0439,
        \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C?
        \u0421\u043A\u0430\u0436\u0438 \u041C\u0438\u0445\u0430\u0438\u043B\u0443
        \u041F\u0430\u0442\u0430\u043F\u044B\u0447\u0443, \u0447\u0442\u043E \u0443
        \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
        \u0441 \u0430\u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u0446\u0438\u0435\u0439.\u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438
        \u0434\u0432\u0438\u0436... \u041D\u0435 \u0432\u0430\u0436\u043D\u043E,
        \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438
        \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0447\u044C, \u043A\u0430\u043A
        \u0431\u0443\u0434\u0435\u0442 \u0432\u0440\u0435\u043C\u044F!"
      objectReference: {fileID: 0}

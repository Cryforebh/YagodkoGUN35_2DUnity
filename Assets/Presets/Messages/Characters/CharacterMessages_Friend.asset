  <Variants>k__BackingField:
  - "\u041E\u0445... \u0422\u0435\u0431\u0435 \u0442\u043E\u0436\u0435 \u0434\u0435\u043B
    \u043D\u0430\u0432\u0430\u043B\u0438\u043B\u0438?"
  - "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0441\u044C, \u044D\u0442\u0438 \u0418\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u044B
    \u043E\u0448\u0430\u043B\u0435\u043B\u0438!"
  - "\u0425\u043E\u0447\u0443 \u0434\u043E\u043C\u043E\u0439..."
  - "\u041F\u0438\u043A\u0441\u0430\u0440 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043E\u0439

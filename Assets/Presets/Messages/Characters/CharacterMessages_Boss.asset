  <Variants>k__BackingField:
  - "\u0412\u0441\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0443\u0436\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B?"
  - "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0434\u043E \u043F\u043E\u0437\u0434\u043D\u0430!"
  - "\u0412\u044B\u0445\u043E\u0434\u043D\u043E\u0439 \u0431\u0443\u0434\u0435\u0442
    \u0437\u0430\u0432\u0442\u0440\u0430!"
  - "\u042F \u0432\u0435\u0434\u044C \u0443\u0436\u0435 \u0434\u0430\u043B \u0442\u0435\u0431\u0435
    \u0437\u0430\u0434\u0430\u0447\u0443?..."
  - "\u0423 \u0442\u0435\u0431\u044F \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E?"
  - "\u0418\u043D\u0432\u0435\u0441\u0442\u043E\u0440\u044B \u0436\u0434\u0443\u0442
    \u043E\u0442\u0447\u0435\u0442\u043E\u0432!"
